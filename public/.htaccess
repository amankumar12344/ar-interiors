<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Allow direct access to existing files
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Route all other requests (including /gallery, /contact, etc.) to index.html
  RewriteRule ^ index.html [L]
</IfModule>
