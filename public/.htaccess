<IfModule mod_headers.c>
  # Prevent aggressive caching of HTML files so updates are immediately visible to clients
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Allow direct access to existing files (css, js, jpg, png, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Route all routes (/about, /services, /gallery, /projects, /process, /contact) to index.html
  RewriteRule ^ index.html [L]
</IfModule>
